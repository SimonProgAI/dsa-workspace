{
  "problem": "activity-selection",
  "signature": "activitySelection(activities: int[][]) -> int",
  "notes": "How many activities [start, end] can be attended without overlap. An activity may start exactly when the previous one ends. Each input is [activities], a list of [start, end] pairs in arbitrary order.",
  "cases": [
    { "name": "classic six activities", "input": [[[1, 3], [2, 5], [4, 6], [6, 7], [5, 9], [8, 9]]], "expected": 4 },
    { "name": "unsorted input", "input": [[[0, 6], [3, 4], [1, 2], [5, 7], [8, 9], [5, 9]]], "expected": 4 },
    { "name": "none overlap", "input": [[[1, 2], [3, 4], [5, 6]]], "expected": 3 },
    { "name": "all overlap", "input": [[[1, 10], [2, 9], [3, 8]]], "expected": 1 },
    { "name": "touching endpoints are compatible", "input": [[[1, 2], [2, 3]]], "expected": 2 }
  ],
  "edgeCases": [
    { "name": "no activities", "input": [[]], "expected": 0 },
    { "name": "single activity", "input": [[[5, 8]]], "expected": 1 },
    { "name": "identical activities", "input": [[[1, 2], [1, 2], [1, 2]]], "expected": 1 },
    { "name": "one long activity blocks two short ones", "input": [[[1, 9], [2, 3], [4, 5]]], "expected": 2 },
    { "name": "zero-length activity", "input": [[[3, 3], [1, 2]]], "expected": 2 }
  ]
}
