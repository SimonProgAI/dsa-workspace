{
  "problem": "two-sum-sorted",
  "signature": "twoSumSorted(nums: int[] (ascending), target: int) -> [int, int]",
  "notes": "Returns the two indices whose values sum to target, low index first, or [-1, -1] when no pair exists. Each input is [nums, target].",
  "cases": [
    { "name": "pair in the middle", "input": [[1, 2, 3, 4, 6], 6], "expected": [1, 3] },
    { "name": "first and last", "input": [[2, 3, 4], 6], "expected": [0, 2] },
    { "name": "adjacent pair", "input": [[1, 2, 3, 4, 4, 9, 56, 90], 8], "expected": [3, 4] },
    { "name": "negative values", "input": [[-1, 0], -1], "expected": [0, 1] },
    { "name": "spans duplicates", "input": [[0, 0, 3, 4], 0], "expected": [0, 1] }
  ],
  "edgeCases": [
    { "name": "empty array", "input": [[], 5], "expected": [-1, -1] },
    { "name": "single element cannot pair", "input": [[3], 3], "expected": [-1, -1] },
    { "name": "no pair sums to target", "input": [[1, 2, 3], 100], "expected": [-1, -1] },
    { "name": "all negative", "input": [[-5, -3, 0, 2], -8], "expected": [0, 1] },
    { "name": "target below every pair", "input": [[1, 2, 3], 0], "expected": [-1, -1] }
  ]
}
