{
  "problem": "binary-tree-inorder",
  "signature": "inorder(root: TreeNode) -> int[]",
  "notes": "The tree is given as an index-addressed level-order array: the children of the node at index i sit at 2i+1 and 2i+2, and null marks a missing node. Build the tree from input[0], then return the inorder (left, root, right) values.",
  "cases": [
    { "name": "balanced three nodes", "input": [[2, 1, 3]], "expected": [1, 2, 3] },
    { "name": "full tree of seven", "input": [[4, 2, 6, 1, 3, 5, 7]], "expected": [1, 2, 3, 4, 5, 6, 7] },
    { "name": "right child only", "input": [[1, null, 2, null, null, 3]], "expected": [1, 3, 2] },
    { "name": "left-skewed", "input": [[3, 2, null, 1]], "expected": [1, 2, 3] },
    { "name": "unsorted values keep tree order", "input": [[5, 9, 1]], "expected": [9, 5, 1] }
  ],
  "edgeCases": [
    { "name": "empty tree", "input": [[]], "expected": [] },
    { "name": "root only", "input": [[1]], "expected": [1] },
    { "name": "duplicate values", "input": [[1, 1, 1]], "expected": [1, 1, 1] },
    { "name": "negative values", "input": [[0, -2, 5]], "expected": [-2, 0, 5] },
    { "name": "right-skewed", "input": [[1, null, 2]], "expected": [1, 2] }
  ]
}
