{
  "problem": "binary-search",
  "signature": "binarySearch(nums: int[] (ascending), target: int) -> int",
  "notes": "Index of target in a sorted array, or -1 when absent. Each input is [nums, target]. Arrays contain no duplicates, so the answer is unique.",
  "cases": [
    { "name": "target in the middle", "input": [[1, 3, 5, 7, 9, 11], 7], "expected": 3 },
    { "name": "first element", "input": [[1, 3, 5, 7, 9, 11], 1], "expected": 0 },
    { "name": "last element", "input": [[1, 3, 5, 7, 9, 11], 11], "expected": 5 },
    { "name": "absent, between elements", "input": [[1, 3, 5, 7, 9, 11], 4], "expected": -1 },
    { "name": "negative values", "input": [[-9, -5, 0, 3, 8], -5], "expected": 1 },
    { "name": "even length", "input": [[2, 4, 6, 8], 6], "expected": 2 }
  ],
  "edgeCases": [
    { "name": "empty array", "input": [[], 5], "expected": -1 },
    { "name": "single element, found", "input": [[42], 42], "expected": 0 },
    { "name": "single element, absent", "input": [[42], 7], "expected": -1 },
    { "name": "below the range", "input": [[1, 2, 3], -100], "expected": -1 },
    { "name": "above the range", "input": [[1, 2, 3], 100], "expected": -1 }
  ]
}
