{
  "problem": "merge-sort",
  "signature": "mergeSort(nums: int[]) -> int[]",
  "notes": "Returns the array sorted ascending. Each input is [nums]. The sort is expected to be stable, though with plain integers that is not observable.",
  "cases": [
    { "name": "shuffled", "input": [[5, 2, 4, 1, 3, 6]], "expected": [1, 2, 3, 4, 5, 6] },
    { "name": "odd length", "input": [[3, 1, 2]], "expected": [1, 2, 3] },
    { "name": "already sorted", "input": [[1, 2, 3, 4]], "expected": [1, 2, 3, 4] },
    { "name": "reverse sorted", "input": [[4, 3, 2, 1]], "expected": [1, 2, 3, 4] },
    { "name": "negatives and zero", "input": [[3, -1, 0, -7, 2]], "expected": [-7, -1, 0, 2, 3] }
  ],
  "edgeCases": [
    { "name": "empty array", "input": [[]], "expected": [] },
    { "name": "single element", "input": [[1]], "expected": [1] },
    { "name": "all equal", "input": [[2, 2, 2]], "expected": [2, 2, 2] },
    { "name": "duplicates interleaved", "input": [[2, 1, 2, 1]], "expected": [1, 1, 2, 2] },
    { "name": "two elements out of order", "input": [[2, 1]], "expected": [1, 2] }
  ]
}
