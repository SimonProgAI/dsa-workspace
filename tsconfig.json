{
  // Type-checking only — tsx and Vitest do the actual running, so nothing is emitted.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    // "bundler" lets the extensionless imports Vitest/tsx accept
    // ("../../harness/ts/dsatest") resolve here too.
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  // templates/ is skipped for the same reason vitest.config.ts excludes it: its
  // relative imports only resolve once the template is copied into a problem folder.
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "templates", "sandbox"]
}
